# All domains, credentials and numbers below are placeholders.
# Existing process environment entries override the repository-root .env.
PORT=3000
HOST=0.0.0.0
API_KEY=
PUBLIC_BASE_URL=https://sms-tester.example

# Messaging-scoped API token; the project Signing Key is a separate credential.
SIGNALWIRE_BASE_URL=https://your-space.signalwire.com/api/laml/2010-04-01
SIGNALWIRE_PROJECT_ID=your-outbound-project-id
SIGNALWIRE_TOKEN=your-messaging-api-token
SIGNALWIRE_SIGNING_KEY=your-outbound-project-signing-key
# E.164 phone number or sender ID, e.g. My-Brand.
# IDs: 1-11 ASCII letters/digits or _ . - + * , # (no spaces).
SIGNALWIRE_FROM=+12025550100
DEFAULT_TO=+12025550101
# Comma-separated complete canonical E.164 numbers. Every number must route here.
ALLOWED_TO_NUMBERS=+12025550101

# Optional exact external URLs, including proxy prefixes and fixed query strings.
# Blank uses PUBLIC_BASE_URL plus /webhooks/signalwire/status or /inbound.
# Reserve test_id for this service; do not put it in either configured URL.
SIGNALWIRE_STATUS_WEBHOOK_URL=
SIGNALWIRE_INBOUND_WEBHOOK_URL=

# Blank means the receiver belongs to the outbound project.
SIGNALWIRE_INBOUND_PROJECT_ID=
# Blank reuses SIGNALWIRE_SIGNING_KEY only when projects are the same.
# A separate receiving project does not need its API token here.
SIGNALWIRE_INBOUND_SIGNING_KEY=

# on | off; default on. off is only for isolated development/tests.
# Temporary JSON webhook support requires explicit off; JSON signing is deferred.
SIGNALWIRE_VERIFY_WEBHOOKS=on
TEST_TIMEOUT_MS=120000
SIGNALWIRE_REQUEST_TIMEOUT_MS=10000
# false: creation + recognized outbound status callback + exact inbound receipt.
# true: also wait for a matching delivered status callback.
REQUIRE_DELIVERED_STATUS=false
# Inbound receipt only: ignore rewritten/missing From and match the exact body
# token plus receiving To/project, SID, direction, media and deadline instead.
# Outbound status callbacks still require the configured sender and SID.
IGNORE_SENDER_FROM=false
MAX_ACTIVE_TESTS=1
# Shared by ALL send endpoints, including diagnostic raw messages.
MIN_SEND_INTERVAL_MS=60000
# Relative paths resolve from the repository root, not the shell directory.
DATA_DIR=./data
